# CivicResolve Environment Variables Example
PORT=5000
NODE_ENV=development

# Google Gemini API Key
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Firebase Admin Credentials (Optional for production Firestore)
# If left blank, CivicResolve runs in Resilient Demo Mode with in-memory persistence
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
