PORT=5000
NODE_ENV=development

# Google Gemini API Key
# If omitted or invalid, CivicResolve seamlessly runs in resilient Demo Mode
GEMINI_API_KEY=

# Firebase Admin Credentials (Optional)
# If omitted or invalid, CivicResolve uses in-memory realistic pre-seeded store
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
